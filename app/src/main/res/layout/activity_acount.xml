<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:context=".acountActivity">

        <ImageView
            android:id="@+id/imageModel"
            android:layout_width="202dp"
            android:layout_height="173dp"
            android:src="@drawable/model1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:ignore="MissingConstraints"
            tools:layout_editor_absoluteY="4dp" />

        <TextView
            android:id="@+id/TVID"
            android:layout_width="125dp"
            android:layout_height="40dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="196dp"
            android:text="Id:"
            android:textSize="24sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/AfficherId"
            android:layout_width="270dp"
            android:layout_height="34dp"
            android:layout_marginTop="199dp"
            android:textSize="20sp"
            app:layout_constraintStart_toEndOf="@+id/TVID"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/IDNOM"
            android:layout_width="125dp"
            android:layout_height="40dp"
            android:layout_marginTop="44dp"
            android:text="Nom:"
            android:textSize="24sp"
            app:layout_constraintStart_toStartOf="@+id/TVID"
            app:layout_constraintTop_toBottomOf="@+id/TVID" />

        <TextView
            android:id="@+id/AffcherNom"
            android:layout_width="270dp"
            android:layout_height="34dp"
            android:layout_marginTop="52dp"
            android:textSize="18sp"
            app:layout_constraintStart_toEndOf="@+id/IDNOM"
            app:layout_constraintTop_toBottomOf="@+id/AfficherId" />

        <TextView
            android:id="@+id/IDEMAIL"
            android:layout_width="125dp"
            android:layout_height="40dp"
            android:layout_marginTop="40dp"
            android:text="Email:"
            android:textSize="24sp"
            app:layout_constraintStart_toStartOf="@+id/IDNOM"
            app:layout_constraintTop_toBottomOf="@+id/IDNOM" />

        <TextView
            android:id="@+id/AfficherEmail"
            android:layout_width="269dp"
            android:layout_height="53dp"
            android:layout_marginTop="44dp"
            android:textSize="18sp"
            app:layout_constraintStart_toEndOf="@+id/IDEMAIL"
            app:layout_constraintTop_toBottomOf="@+id/AffcherNom" />

        <TextView
            android:id="@+id/IDTYPE"
            android:layout_width="125dp"
            android:layout_height="40dp"
            android:layout_marginTop="52dp"
            android:text="Type:"
            android:textSize="24sp"
            app:layout_constraintStart_toStartOf="@+id/IDEMAIL"
            app:layout_constraintTop_toBottomOf="@+id/IDEMAIL" />

        <TextView
            android:id="@+id/AfficherType"
            android:layout_width="270dp"
            android:layout_height="34dp"
            android:layout_marginTop="42dp"
            android:textSize="18sp"
            app:layout_constraintStart_toEndOf="@+id/IDTYPE"
            app:layout_constraintTop_toBottomOf="@+id/AfficherEmail" />

        <TextView
            android:id="@+id/M_NO"
            android:layout_width="278dp"
            android:layout_height="44dp"
            android:layout_marginTop="56dp"
            android:text="Modifier nom"
            android:textSize="18sp"
            app:layout_constraintStart_toStartOf="@+id/IDTYPE"
            app:layout_constraintTop_toBottomOf="@+id/IDTYPE" />

        <TextView
        android:id="@+id/M_MDP"
        android:layout_width="300dp"
        android:layout_height="40dp"
        android:layout_marginTop="14dp"
        android:text="Modifier mot de passe"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="@+id/M_NO"
        app:layout_constraintTop_toBottomOf="@+id/M_NO" />

</androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>