<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".themeActivity2"
    tools:ignore="ExtraText">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/mytoolbar1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0FC7FF"
        tools:ignore="ExtraText,MissingConstraints"
        tools:context=".themeActivity2">
    </androidx.appcompat.widget.Toolbar>


    <RelativeLayout
        android:id="@+id/linearLayout1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:ignore="MissingConstraints">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar1"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="0dp"
            android:background="#0FC7FF"
            android:elevation="4dp" />

    </RelativeLayout>
    <Button
        android:id="@+id/button12"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/circular_button_background"
        android:text="+"
        android:textSize="24sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/button13"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="90dp"
        android:background="@drawable/circular_button_background"
        android:text="+"
        android:gravity="center"
        android:textSize="14sp"
        app:backgroundTint="#45A3FF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone"/>

    <Button
        android:id="@+id/button14"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="136dp"
        android:background="@drawable/circular_button_background"
        android:text="+"
        android:gravity="center"
        android:textSize="14sp"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/textViewSec"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:text="Ajouter Sous Thème"
        android:textColor="#221F1F"
        app:layout_constraintEnd_toStartOf="@+id/button14"
        app:layout_constraintTop_toTopOf="@+id/button14"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/textViewSec2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:text="Ajouter Objectif"
        android:textColor="#221F1F"
        app:layout_constraintEnd_toStartOf="@+id/button13"
        app:layout_constraintTop_toTopOf="@+id/button13"
        android:visibility="gone"/>

    <LinearLayout
        android:id="@+id/ouss"
        android:layout_marginTop="56dp"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:id="@+id/F1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Ajoutez ici les vues que vous souhaitez placer dans la F1 -->

        </FrameLayout>

        <FrameLayout
            android:id="@+id/F2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Ajoutez ici les vues que vous souhaitez placer dans la F2 -->

        </FrameLayout>

    </LinearLayout>



</androidx.constraintlayout.widget.ConstraintLayout>