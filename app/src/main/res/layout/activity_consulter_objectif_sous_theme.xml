<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:context=".ConsulterObjectif">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar3"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="0dp"
            android:background="#0FC7FF"
            android:elevation="4dp"
            tools:ignore="MissingConstraints" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="100dp"
            android:layout_height="35dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="79dp"
            android:text="Titre:"
            android:textSize="15sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textView6"
            android:layout_width="248dp"
            android:layout_height="35dp"
            android:layout_marginStart="26dp"
            android:layout_marginTop="81dp"
            android:text=""
            app:layout_constraintStart_toEndOf="@+id/textView"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textView7"
            android:layout_width="100dp"
            android:layout_height="35dp"
            android:layout_marginTop="50dp"
            android:text="Description:"
            app:layout_constraintStart_toStartOf="@+id/textView"
            app:layout_constraintTop_toBottomOf="@+id/textView" />

        <TextView
            android:id="@+id/textView8"
            android:layout_width="248dp"
            android:layout_height="95dp"
            android:layout_marginTop="52dp"
            android:text=""
            app:layout_constraintStart_toStartOf="@+id/textView6"
            app:layout_constraintTop_toBottomOf="@+id/textView6" />

        <TextView
            android:id="@+id/textView9"
            android:layout_width="100dp"
            android:layout_height="35dp"
            android:layout_marginTop="102dp"
            android:text="Date de début:"
            app:layout_constraintStart_toStartOf="@+id/textView7"
            app:layout_constraintTop_toBottomOf="@+id/textView7" />

        <TextView
            android:id="@+id/textView10"
            android:layout_width="248dp"
            android:layout_height="35dp"
            android:layout_marginTop="42dp"
            android:text=""
            app:layout_constraintStart_toStartOf="@+id/textView8"
            app:layout_constraintTop_toBottomOf="@+id/textView8" />

        <TextView
            android:id="@+id/textView11"
            android:layout_width="110dp"
            android:layout_height="35dp"
            android:layout_marginTop="56dp"
            android:text="Rappel:"
            app:layout_constraintStart_toStartOf="@+id/textView9"
            app:layout_constraintTop_toBottomOf="@+id/textView9" />

        <TextView
            android:id="@+id/textView12"
            android:layout_width="248dp"
            android:layout_height="35dp"
            android:layout_marginTop="56dp"
            android:text=""
            app:layout_constraintStart_toStartOf="@+id/textView10"
            app:layout_constraintTop_toBottomOf="@+id/textView10" />

        <TextView
            android:id="@+id/textView13"
            android:layout_width="100dp"
            android:layout_height="35dp"
            android:layout_marginTop="52dp"
            android:text="Date de fin:"
            app:layout_constraintStart_toStartOf="@+id/textView11"
            app:layout_constraintTop_toBottomOf="@+id/textView11" />


        <TextView
            android:id="@+id/textView14"
            android:layout_width="248dp"
            android:layout_height="35dp"
            android:layout_marginTop="48dp"
            android:text=""
            app:layout_constraintStart_toStartOf="@+id/textView12"
            app:layout_constraintTop_toBottomOf="@+id/textView12" />

        <TextView
            android:id="@+id/textView015"
            android:layout_width="100dp"
            android:layout_height="35dp"
            android:layout_marginTop="20dp"
            android:text="Difficulté:"
            app:layout_constraintStart_toStartOf="@+id/textView13"
            app:layout_constraintTop_toBottomOf="@+id/textView13" />

        <TextView
            android:id="@+id/textView16"
            android:layout_width="248dp"
            android:layout_height="35dp"
            android:layout_marginTop="20dp"
            android:text=""
            app:layout_constraintStart_toStartOf="@+id/textView14"
            app:layout_constraintTop_toBottomOf="@+id/textView14" />

        <TextView
            android:id="@+id/Ajouter_Cri"
            android:layout_width="60dp"
            android:layout_height="30dp"
            android:layout_marginTop="72dp"
            android:layout_marginEnd="64dp"
            android:background="@drawable/bord_plu"
            android:gravity="center"
            android:text="+"
            android:textColor="#808080"
            app:backgroundTint="@null"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView14" />

        <FrameLayout
            android:id="@+id/F5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            app:layout_constraintTop_toBottomOf="@+id/Ajouter_Cri">
            <!-- Ajoutez ici les vues que vous souhaitez placer dans la F2 -->

        </FrameLayout>

        <TextView
            android:id="@+id/Cr"
            android:layout_width="83dp"
            android:layout_height="30dp"
            android:layout_marginTop="72dp"
            android:text="Critères:"
            android:textSize="18sp"
            app:layout_constraintStart_toStartOf="@+id/textView13"
            app:layout_constraintTop_toBottomOf="@+id/textView13" />

        <TextView
            android:id="@+id/textView15"
            android:layout_width="120dp"
            android:layout_height="32dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="40dp"
            android:text="Qualification:"
            android:textSize="18sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/F5" />

        <TextView
            android:id="@+id/Qpr"
            android:layout_width="238dp"
            android:layout_height="34dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="40dp"
            android:textSize="19sp"
            app:layout_constraintStart_toEndOf="@+id/textView15"
            app:layout_constraintTop_toBottomOf="@+id/F5" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
