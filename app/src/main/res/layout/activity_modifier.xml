<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".modifierActivity">

    <ImageView
        android:id="@+id/imageModel"
        android:layout_width="250dp"
        android:layout_height="230dp"
        android:src="@drawable/model1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:layout_editor_absoluteY="4dp" />

    <TextView
        android:id="@+id/textNom"
        android:layout_width="120dp"
        android:layout_height="40dp"
        android:layout_marginTop="310dp"
        android:text="Nom:"
        android:textSize="24sp"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout_editor_absoluteX="16dp" />

    <TextView
        android:id="@+id/AfficherNom2"
        android:layout_width="270dp"
        android:layout_height="51dp"
        android:layout_marginTop="360dp"
        android:text="TextView"
        android:textSize="24sp"
        app:layout_constraintStart_toEndOf="@+id/textNom"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="180dp"
        android:layout_height="39dp"
        android:layout_marginTop="32dp"
        android:text="Mot de passe:"
        android:textSize="24sp"
        app:layout_constraintStart_toStartOf="@+id/textNom"
        app:layout_constraintTop_toBottomOf="@+id/AfficherNom2" />

    <TextView
        android:id="@+id/AfficherMotPasse"
        android:layout_width="270dp"
        android:layout_height="51dp"
        android:layout_marginStart="-65dp"
        android:layout_marginTop="8dp"
        android:text="TextView"
        android:textSize="24sp"
        app:layout_constraintStart_toEndOf="@+id/textView3"
        app:layout_constraintTop_toBottomOf="@+id/textView3" />

    <Button
        android:id="@+id/btChangerNom"
        android:layout_width="149dp"
        android:layout_height="72dp"
        android:layout_marginStart="40dp"
        android:layout_marginTop="108dp"
        android:text="Modifier Nom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView3" />

    <Button
        android:id="@+id/btnChangerPass"
        android:layout_width="149dp"
        android:layout_height="72dp"
        android:layout_marginTop="108dp"
        android:layout_marginEnd="40dp"
        android:text="Modifier Mot de pass"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView3" />
</androidx.constraintlayout.widget.ConstraintLayout>